{
  "expo": {
    "name": "Boiler Plate",
    "slug": "boiler-plate",
    "version": "1.0.0",
    "scheme": "boiler-plate",
    "jsEngine": "hermes",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "rocks.conner.expo-router",
      "googleServicesFile": "./google/GoogleService-Info.plist"
    },
    "android": {
      "package": "rocks.conner.exporouter",
      "googleServicesFile": "./google/google-services.json"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/crashlytics",
      "@react-native-tvos/config-tv"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1be563af-bff2-45c7-88af-b4ad61eba88c"
      }
    }
  }
}
